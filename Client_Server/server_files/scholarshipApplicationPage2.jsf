			<script type="text/javascript">
			jQuery(document).ready(function() {
				Richfaces.showModalPanel('studentTimeLeftModal');
				while(true){
					if(jQuery('.noMaskClass2 .rich-mpnl-mask-div').css('z-index') != -200){
						break;
					}
				}
				jQuery('.noMaskClass2 .rich-mpnl-mask-div').css('width',0);
				jQuery('.noMaskClass2 .rich-mpnl-mask-div').css('height',0);
				var timeLeftInMillisec;
				var myTimer;
				function refreshStudentTimeLeft(){
		            if (timeLeftInMillisec <= 0) {
		            	clearInterval(myTimer);
		            	//jQuery("#studentTimeLeftModalContentTable").css("background-color","#000000");
		            	jQuery('#studentTimeLeft').css("color","red");
		            	jQuery('#studentTimeLeft').html("00:00");
		            	return;
		            } else {
		                var left, days, hours, minutes, seconds, timeLeftStr = '';
		                left = timeLeftInMillisec;
		                days = parseInt(left / (1000 * 60 * 60 * 24));
		                left = left - (days * 1000 * 60 * 60 * 24);
		                hours = parseInt(left / (1000 * 60 * 60));
		                left = left - (hours * 1000 * 60 * 60);
		                minutes = parseInt(left / (1000 * 60));
		                left = left - (minutes * 1000 * 60);
		                seconds = parseInt(left / 1000);
		                if (0 != days) {
		                	timeLeftStr = timeLeftStr + days;
		                	timeLeftStr = timeLeftStr +"D ";
		                	if (hours < 10) {
			                	timeLeftStr = timeLeftStr +"0";
			                }
			                timeLeftStr = timeLeftStr + hours;
			                timeLeftStr = timeLeftStr + ":";
		                }else if (hours != 0) {
			                if (hours < 10) {
			                	timeLeftStr = timeLeftStr +"0";
			                }
			                timeLeftStr = timeLeftStr + hours;
			                timeLeftStr = timeLeftStr + ":";
		                }
		                if (minutes < 10) {
		                	timeLeftStr = timeLeftStr + "0";
		                }
		                timeLeftStr = timeLeftStr + minutes;
		                timeLeftStr = timeLeftStr + ":";
		                if (seconds < 10) {
		                	timeLeftStr = timeLeftStr + "0";
		                }
		                timeLeftStr = timeLeftStr + seconds;
		                if(days == 0 && hours == 0 && minutes == 0 && seconds < 10){
		                	jQuery('#studentTimeLeft').css("color","#FF7F00");
		                }
		                if(days == 0 && hours == 0 && minutes == 0 && seconds==0){
		                	//jQuery("#studentTimeLeftModalContentTable").css("background-color","#000000");
		                	jQuery('#studentTimeLeft').css("color","red");
		                }
		                jQuery('#studentTimeLeft').html(timeLeftStr);
		            }
				}
				timeLeftInMillisec = parseInt(jQuery('#studentTimeLeftInMillisec').html(),10);
				refreshStudentTimeLeft();
				myTimer = setInterval(function(){timeLeftInMillisec = timeLeftInMillisec - 1000;refreshStudentTimeLeft();},1000);
			});	
	</script></div>
