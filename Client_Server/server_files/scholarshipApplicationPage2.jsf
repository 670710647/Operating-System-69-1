rich-mpnl-mask-div-transparent" id="studentTimeLeftModalCursorDiv" style="z-index: -200;"><button class="rich-mpnl-button" id="studentTimeLeftModalLastHref"></button></div><script type="text/javascript">new ModalPanel('studentTimeLeftModal',
				{
					width: -1,
					height: -1,

					minWidth: -1,
					minHeight: -1,

					resizeable: false,
					moveable: true,

					left: "0px",
					top: "77px",

					zindex: 100,onresize: '',onmove: '',onshow: '',onhide: '',onbeforeshow: '',onbeforehide: '',
					domElementAttachment: "",				
					keepVisualState: false,
